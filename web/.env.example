# Supabase project (read-only publishable key: views v_*, table live_feed, rpc fn_nashra)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# n8n engine base URL (the /v1/* webhooks live under it)
VITE_ENGINE_URL=https://your-n8n-host/webhook

# true = answer from src/mocks instead of calling the engine
VITE_USE_MOCK=true
