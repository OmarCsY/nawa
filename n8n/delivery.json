        "url": "https://automations-waha.gkrgfu.easypanel.host/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "REDACTED_USE_EXISTING_WAHA_SECRET"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({session:$('Delivery items').item.json.session,chatId:$('Delivery items').item.json.chatId,text:(()=>{const p=$('Delivery items').item.json.payload;let t=p.reply_ar||'';\nconst card=p.card;\nif(card?.type==='plan')t+='\\nخطة رقم '+card.id+'\\n'+(card.data?.steps||[]).map(s=>s.text_ar).join('\\n');\nif(card?.type==='measurement')t+='\\n'+(card.data?.items||[]).map(x=>x.item_ar+': '+x.grams+' جرام').join('\\n');\nif(p.data?.days)t+='\\n'+p.data.days.map(d=>d.day+': '+({high:'خطر مرتفع',mid:'خطر متوسط',low:'خطر منخفض'}[d.level]||d.level)+(d.reason_ar?' — '+d.reason_ar:'')).join('\\n');\nfor(const m of p.messages||[])if(m.reply_ar)t+='\\n'+m.reply_ar;\nif(card?.type==='plan'&&(p.buttons||[]).some(b=>b.id==='accept_plan'))t+='\\nاكتب «بطبقها '+card.id+'» أو «ذكرني '+card.id+'» أو «ما تناسبنا '+card.id+'».';\nif((p.buttons||[]).some(b=>b.id?.startsWith('adherence_')))t+='\\nاكتب «طبقتها '+(card?.id||p.buttons[0].target_id)+'» أو «جزئيا '+(card?.id||p.buttons[0].target_id)+'» أو «ما طبقتها '+(card?.id||p.buttons[0].target_id)+'».';\nreturn t;\n})()}) }}",
        "options": {
          "timeout": 30000
        }
      },
